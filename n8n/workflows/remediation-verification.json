    {
      "parameters": {
        "jsCode": "// Extract CVE + asset name from the ticket title '[P1-...] Fix CVE-x on Asset'\nconst issue = $input.first().json;\nconst m = issue.title.match(/\\[(P\\d)-[A-Z]+\\] Fix (CVE-\\d{4}-\\d{4,}) on (.+)$/);\nif (!m) {\n  return [{ json: { error: 'Cannot parse ticket title: ' + issue.title, ticket: issue.number } }];\n}\nreturn [{ json: { ticket: issue.number, cve: m[2], asset_name: m[3].trim(), state: issue.state } }];"
      },
      "id": "d3000000-0002-4000-8000-verify0003",
      "name": "Parse CVE + Asset",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
