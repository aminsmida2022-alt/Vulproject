      "parameters": {
        "jsCode": "// Is the CVE still present on the same asset in the fresh scan?\nconst ctx = $('Parse CVE + Asset').first().json;\nconst fresh = $input.all().map(i => i.json);\nconst stillThere = fresh.some(f => f.cve === ctx.cve && f.asset_name === ctx.asset_name);\nconst evidence = {\n  ticket: ctx.ticket,\n  cve: ctx.cve,\n  asset: ctx.asset_name,\n  scanned_at: new Date().toISOString(),\n  still_present: stillThere,\n  total_findings_in_scan: fresh.length\n};\nreturn [{ json: evidence }];"
      },
