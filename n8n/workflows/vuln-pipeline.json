    {
      "parameters": {
        "jsCode": "// Dedupe, same policy as the local fallback (scripts/enrich.py):\n// 1) within an asset, one finding per CVE (highest CVSS wins)\n// 2) across assets, one finding per CVE+package+version\nconst raw = $input.all().map(i => i.json);\nconst perAsset = new Map();\nfor (const f of raw) {\n  const k1 = f.asset_id + '|' + f.cve;\n  const prev = perAsset.get(k1);\n  if (!prev || (f.cvss ?? 0) > (prev.cvss ?? 0)) perAsset.set(k1, f);\n}\nconst best = new Map();\nfor (const f of perAsset.values()) {\n  const k2 = f.cve + '|' + (f.pkg ?? '') + '|' + (f.installed ?? '');\n  const prev = best.get(k2);\n  if (!prev || (f.cvss ?? 0) > (prev.cvss ?? 0)) best.set(k2, f);\n}\nconst findings = [...best.values()];\nreturn [{ json: { findings, count: findings.length } }];"
      },
      "id": "b1000000-0007-4000-8000-pipeline008",
      "name": "Dedupe Findings",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1060,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// Build EPSS batches (max 100 CVEs per FIRST API call)\nconst { findings } = $input.first().json;\nconst cves = findings.map(f => f.cve);\nconst batches = [];\nfor (let i = 0; i < cves.length; i += 100) {\n  batches.push({ json: { batch: cves.slice(i, i + 100).join(',') } });\n}\nreturn batches;"
      },
      "id": "b1000000-0008-4000-8000-pipeline009",
      "name": "Build EPSS Batches",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1300,
        0
      ]
    },
    {
      "parameters": {
        "url": "=https://api.first.org/data/v1/epss?cve={{ $json.batch }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/json"
            }
          ]
        },
        "options": {}
      },
      "id": "b1000000-0009-4000-8000-pipeline010",
      "name": "Fetch EPSS Scores",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1540,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// Merge EPSS responses (order matches batches)\nconst responses = $input.all().map(i => i.json.data ?? []);\nconst batches = $('Build EPSS Batches').all().map(i => i.json.batch);\nconst epssMap = {};\nresponses.forEach((data, idx) => {\n  for (const row of data) epssMap[row.cve] = parseFloat(row.epss ?? 0);\n});\nconst findings = $('Dedupe Findings').first().json.findings;\nreturn [{ json: { findings, epssMap, batches: batches.length } }];"
      },
      "id": "b1000000-0010-4000-8000-pipeline011",
