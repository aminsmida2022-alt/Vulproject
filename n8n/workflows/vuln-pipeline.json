        [{ "node": "Create Gitea Ticket", "type": "main", "index": 0 }],
        []
      ]
    }
  },
  "active": false,
  "settings": { "executionOrder": "v1" },
  "pinData": {},
  "meta": {
    "description": "Full A-to-Z SOAR pipeline: scheduled/manual trigger, Trivy scan via agent API, dedupe, EPSS + CISA KEV enrichment, contextual priority scoring, dashboard publication, Gitea ticket creation with dedupe."
