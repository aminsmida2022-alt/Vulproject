    {
      "parameters": {
        "jsCode": "// Only P1/P2 findings (score >= 60) deserve a remediation ticket.\n// Read from 'Compute Priority' (the previous node's output is the dashboard's reply).\nconst { findings } = $('Compute Priority').first().json;\nconst candidates = findings.filter(f => f.priority_score >= 60);\nreturn [{ json: { candidates, total_findings: findings.length, ticket_worthy: candidates.length } }];\n"
      },
      "id": "b1000000-0021-4000-8000-pipeline022",
      "name": "Select P1/P2 Findings",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3220,
        0
      ]
    },
    {
      "parameters": {
        "url": "http://gitea:3000/api/v1/repos/vulnadmin/remediation-tickets/labels?limit=100",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=token {{ $env.N8N_GITEA_TOKEN }}"
