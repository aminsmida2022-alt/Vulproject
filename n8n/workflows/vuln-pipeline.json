{
  "name": "Vulnerability Pipeline (A to Z)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [{ "field": "cronExpression", "expression": "0 3 * * *" }]
        }
      },
      "id": "b1000000-0000-4000-8000-pipeline001",
      "name": "Daily Schedule",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [-400, 0]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "scan-request",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "b1000000-0001-4000-8000-pipeline002",
      "name": "Manual Scan Request",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-400, 200],
      "webhookId": "scan-request"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:8000/api/agent/scan/start",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "X-Agent-Token", "value": "***REMOVED***" },
            { "name": "Content-Type", "value": "application/json" },
            { "name": "Accept", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ mode: 'pipeline' }) }}",
        "options": {
          "response": { "response": { "neverError": true } }
