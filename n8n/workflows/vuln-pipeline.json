      },
      "id": "b1000000-0002-4000-8000-pipeline003",
      "name": "Start Trivy Scan",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-160, 100]
    },
    {
      "parameters": {
        "resume": "timeInterval",
        "amount": 45,
        "unit": "seconds"
      },
      "id": "b1000000-0003-4000-8000-pipeline004",
      "name": "Wait 45s",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [80, 100],
      "webhookId": "pipeline-wait-1"
    },
    {
      "parameters": {
        "url": "http://host.docker.internal:8000/api/agent/scan/status",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "X-Agent-Token", "value": "***REMOVED***" },
            { "name": "Accept", "value": "application/json" }
          ]
        },
        "options": {}
      },
      "id": "b1000000-0004-4000-8000-pipeline005",
      "name": "Poll Scan Status",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [320, 100]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "leftValue": "={{ $json.state === 'running' }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "true" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "b1000000-0005-4000-8000-pipeline006",
      "name": "Still running?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [560, 100]
    },
    {
      "parameters": {
        "url": "http://host.docker.internal:8000/api/agent/reports/raw",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "X-Agent-Token", "value": "***REMOVED***" },
            { "name": "Accept", "value": "application/json" }
          ]
        },
        "options": {}
      },
      "id": "b1000000-0006-4000-8000-pipeline007",
      "name": "Fetch Raw Findings",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [820, 0]
    },
    {
      "parameters": {
        "jsCode": "// Dedupe, same policy as the local fallback (scripts/enrich.py):\n// 1) within an asset, one finding per CVE (highest CVSS wins)\n// 2) across assets, one finding per CVE+package+version\nconst raw = $input.all().map(i => i.json);\nconst perAsset = new Map();\nfor (const f of raw) {\n  const k1 = f.asset_id + '|' + f.cve;\n  const prev = perAsset.get(k1);\n  if (!prev || (f.cvss ?? 0) > (prev.cvss ?? 0)) perAsset.set(k1, f);\n}\nconst best = new Map();\nfor (const f of perAsset.values()) {\n  const k2 = f.cve + '|' + (f.pkg ?? '') + '|' + (f.installed ?? '');\n  const prev = best.get(k2);\n  if (!prev || (f.cvss ?? 0) > (prev.cvss ?? 0)) best.set(k2, f);\n}\nconst findings = [...best.values()];\nreturn [{ json: { findings, count: findings.length } }];"
      },
      "id": "b1000000-0007-4000-8000-pipeline008",
      "name": "Dedupe Findings",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1060, 0]
    },
    {
      "parameters": {
        "jsCode": "// Build EPSS batches (max 100 CVEs per FIRST API call)\nconst { findings } = $input.first().json;\nconst cves = findings.map(f => f.cve);\nconst batches = [];\nfor (let i = 0; i < cves.length; i += 100) {\n  batches.push({ json: { batch: cves.slice(i, i + 100).join(',') } });\n}\nreturn batches;"
      },
      "id": "b1000000-0008-4000-8000-pipeline009",
      "name": "Build EPSS Batches",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1300, 0]
    },
    {
      "parameters": {
        "url": "=https://api.first.org/data/v1/epss?cve={{ $json.batch }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Accept", "value": "application/json" }
          ]
        },
        "options": {}
      },
      "id": "b1000000-0009-4000-8000-pipeline010",
      "name": "Fetch EPSS Scores",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1540, 0]
    },
    {
      "parameters": {
        "jsCode": "// Merge EPSS responses (order matches batches)\nconst responses = $input.all().map(i => i.json.data ?? []);\nconst batches = $('Build EPSS Batches').all().map(i => i.json.batch);\nconst epssMap = {};\nresponses.forEach((data, idx) => {\n  for (const row of data) epssMap[row.cve] = parseFloat(row.epss ?? 0);\n});\nconst findings = $('Dedupe Findings').first().json.findings;\nreturn [{ json: { findings, epssMap, batches: batches.length } }];"
      },
      "id": "b1000000-0010-4000-8000-pipeline011",
      "name": "Merge EPSS",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1780, 0]
    },
    {
      "parameters": {
        "url": "http://host.docker.internal:8000/api/agent/kev",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "X-Agent-Token", "value": "***REMOVED***" },
            { "name": "Accept", "value": "application/json" }
          ]
        },
        "options": {}
      },
      "id": "b1000000-0011-4000-8000-pipeline012",
      "name": "Fetch CISA KEV",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2020, 0]
    },
    {
      "parameters": {
        "url": "http://host.docker.internal:8000/api/agent/assets",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "X-Agent-Token", "value": "***REMOVED***" },
            { "name": "Accept", "value": "application/json" }
          ]
        },
        "options": {}
      },
      "id": "b1000000-0012-4000-8000-pipeline013",
      "name": "Fetch Asset Inventory",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2260, 0]
    },
    {
      "parameters": {
        "url": "http://host.docker.internal:8000/api/agent/exceptions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "X-Agent-Token", "value": "***REMOVED***" },
            { "name": "Accept", "value": "application/json" }
          ]
        },
        "options": {
          "response": { "response": { "neverError": true } }
        }
      },
      "id": "b1000000-0013-4000-8000-pipeline014",
      "name": "Fetch Accepted Risks",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2500, 0]
    },
    {
      "parameters": {
        "jsCode": "// P = 0.25*C + 0.30*E + 0.25*K + 0.20*A\nconst { findings, epssMap } = $('Merge EPSS').first().json;\nconst kevSet = new Set($('Fetch CISA KEV').first().json.cves);\nconst assets = new Map($('Fetch Asset Inventory').first().json.assets.map(a => [a.asset_id, a]));\nconst exceptions = new Map($('Fetch Accepted Risks').first().json.exceptions.map(e => [e.cve, e]));\n\nconst label = s => s >= 80 ? 'P1-CRITICAL' : s >= 60 ? 'P2-HIGH' : s >= 40 ? 'P3-MEDIUM' : s >= 20 ? 'P4-LOW' : 'P5-INFORMATIONAL';\n\nconst enriched = [];\nfor (const f of findings) {\n  const exc = exceptions.get(f.cve);\n  if (exc) continue; // accepted risk, dated and approved -> excluded\n\n  const c = Math.min((f.cvss ?? 0) / 10 * 100, 100);\n  const e = (epssMap[f.cve] ?? 0) * 100;\n  const k = kevSet.has(f.cve) ? 100 : 0;\n  const a = f.importance ?? 50;\n  const score = Math.round((0.25 * c + 0.30 * e + 0.25 * k + 0.20 * a) * 100) / 100;\n\n  enriched.push({\n    ...f,\n    epss: epssMap[f.cve] ?? 0,\n    kev: kevSet.has(f.cve),\n    priority_score: score,\n    priority: label(score),\n  });\n}\n\nenriched.sort((x, y) => y.priority_score - x.priority_score);\nreturn [{ json: { findings: enriched } }];"
      },
      "id": "b1000000-0014-4000-8000-pipeline015",
      "name": "Compute Priority",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2740, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:8000/api/agent/findings",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "X-Agent-Token", "value": "***REMOVED***" },
            { "name": "Content-Type", "value": "application/json" },
            { "name": "Accept", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ findings: $json.findings }) }}",
        "options": {}
      },
      "id": "b1000000-0015-4000-8000-pipeline016",
      "name": "Publish Findings to Dashboard",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2980, 0]
    },
    {
      "parameters": {
        "jsCode": "// Only P1/P2 findings deserve a remediation ticket\nconst { findings } = $input.first().json;\nreturn findings\n  .filter(f => f.priority_score >= 60)\n  .map(f => ({ json: f }));"
      },
      "id": "b1000000-0016-4000-8000-pipeline017",
      "name": "Ticket-worthy (P1/P2)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [3220, 0]
    },
    {
      "parameters": {
        "url": "=http://gitea:3000/api/v1/repos/vulnadmin/remediation-tickets/issues?state=open&q={{ $json.cve }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "token 413771fee52623e9fd2c67a053b68c16d88ad638" },
            { "name": "Accept", "value": "application/json" }
          ]
        },
        "options": {}
      },
      "id": "b1000000-0017-4000-8000-pipeline018",
      "name": "Check open ticket (dedupe)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [3460, 0],
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "leftValue": "={{ $json.number === undefined }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "true" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "b1000000-0018-4000-8000-pipeline019",
      "name": "No open ticket yet?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [3700, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://gitea:3000/api/v1/repos/vulnadmin/remediation-tickets/issues",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "token 413771fee52623e9fd2c67a053b68c16d88ad638" },
            { "name": "Content-Type", "value": "application/json" },
            { "name": "Accept", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify((function(){ var f = $('Ticket-worthy (P1/P2)').item.json; var kev = f.kev ? 'YES - actively exploited in the wild (CISA KEV)' : 'No'; var fix = f.fixed ? f.fixed : 'no fixed version available'; var epss = f.epss != null ? (f.epss * 100).toFixed(2) + '%' : 'unknown'; var lines = [ '## Remediation ticket', '', '| Field | Value |', '|---|---|', '| CVE | ' + f.cve + ' |', '| Asset | ' + f.asset_name + ' (' + f.asset_criticality + ' importance) |', '| Package | ' + f.pkg + ' - installed ' + f.installed + ', fixed in ' + fix + ' |', '| Severity | ' + f.severity + ' (CVSS ' + f.cvss + ') |', '| EPSS exploitation probability | ' + epss + ' |', '| CISA KEV listed | ' + kev + ' |', '| Contextual priority | ' + f.priority_score + ' / 100 - ' + f.priority + ' |', '', '> ' + (f.title || ''), '', '### Priority formula', 'P = 0.25*CVSS + 0.30*EPSS + 0.25*KEV + 0.20*Asset importance', '', '### Acceptance criteria', '- [ ] Apply the fix (upgrade package or rebuild image)', '- [ ] Request verification scan', '- [ ] Ticket is closed ONLY if a new scan proves the finding is gone' ]; return { title: '[' + f.priority + '] Fix ' + f.cve + ' on ' + f.asset_name, body: lines.join('\\n') }; })()) }}",
        "options": {}
      },
      "id": "b1000000-0019-4000-8000-pipeline020",
      "name": "Create Gitea Ticket",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [3940, 0]
    }
  ],
  "connections": {
