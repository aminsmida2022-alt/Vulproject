      "id": "b1000000-0022-4000-8000-pipeline023",
      "name": "Load Gitea Labels",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        3460,
        0
      ],
      "executeOnce": true
    },
    {
      "parameters": {
        "jsCode": "// Load every remediation ticket (open + closed, paginated) to dedupe and detect regressions.\nconst GITEA = 'http://gitea:3000/api/v1/repos/vulnadmin/remediation-tickets';\nconst headers = { Authorization: 'token ' + $env.N8N_GITEA_TOKEN, Accept: 'application/json' };\nconst tickets = [];\nfor (let page = 1; page < 50; page++) {\n  const batch = await this.helpers.httpRequest({\n    url: `${GITEA}/issues?state=all&type=issues&limit=50&page=${page}`, headers, json: true,\n  });\n  tickets.push(...batch.map(i => ({\n    number: i.number, state: i.state, title: i.title,\n    labels: (i.labels || []).map(l => ({ id: l.id, name: l.name })),\n  })));\n  if (batch.length < 50) break;\n}\nconst labelIds = Object.fromEntries($('Load Gitea Labels').all().map(i => [i.json.name, i.json.id]));\nreturn [{ json: { tickets, labelIds } }];\n"
      },
      "id": "b1000000-0023-4000-8000-pipeline024",
      "name": "Load Existing Tickets",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3700,
        0
      ],
      "executeOnce": true
    },
    {
      "parameters": {
        "jsCode": "// Decide one action per P1/P2 finding:\n//   create  -> no ticket yet for this CVE + asset\n//   reopen  -> ticket was closed (verified fixed) but the CVE is back = regression\n//   skip    -> ticket already open, or risk formally accepted\nconst SLA_DAYS = { 'P1-CRITICAL': 7, 'P2-HIGH': 30 };\nconst TITLE_RE = /\\[(P\\d-[A-Z]+)\\] Fix (CVE-\\d{4}-\\d+) on (.+)$/;\nconst { candidates } = $('Select P1/P2 Findings').first().json;\nconst { tickets, labelIds } = $input.first().json;\n\nconst byKey = {};\nfor (const t of tickets) {\n  const m = t.title.match(TITLE_RE);\n  if (!m) continue;\n  const key = m[2] + '|' + m[3].trim();\n  if (!byKey[key] || t.number > byKey[key].number) byKey[key] = t;  // latest ticket wins\n}\nconst has = (t, name) => t.labels.some(l => l.name === name);\nconst scanDate = new Date().toISOString();\nconst out = [];\n\nfor (const f of candidates) {\n  const t = byKey[f.cve + '|' + f.asset_name];\n  const ref = { cve: f.cve, asset: f.asset_name, priority: f.priority, score: f.priority_score };\n\n  if (t && has(t, 'risk-accepted')) { out.push({ json: { ...ref, action: 'skip', reason: 'risk-accepted', ticket: t.number } }); continue; }\n  if (t && t.state === 'open')      { out.push({ json: { ...ref, action: 'skip', reason: 'already-open', ticket: t.number } }); continue; }\n\n  if (t && t.state === 'closed') {\n    const labels = t.labels.filter(l => l.name !== 'verified-fixed').map(l => l.id);\n    if (labelIds['regression'] && !labels.includes(labelIds['regression'])) labels.push(labelIds['regression']);\n    out.push({ json: { ...ref, action: 'reopen', ticket: t.number, labels,\n      comment: `### Regression detected\\n${f.cve} is present again on **${f.asset_name}** ` +\n               `(${f.pkg} ${f.installed}) in the scan of ${scanDate}.\\n` +\n               `Ticket reopened automatically by the n8n pipeline.` } });\n    continue;\n  }\n\n  const days = SLA_DAYS[f.priority] ?? 30;\n  const due = new Date(Date.now() + days * 86400000);\n  const epss = f.epss != null ? (f.epss * 100).toFixed(2) + '%' : 'unknown';\n  const body = [\n    '## Remediation ticket', '',\n    '| Field | Value |', '|---|---|',\n    `| CVE | ${f.cve} |`,\n    `| Asset | ${f.asset_name} (\\`${f.asset_id}\\`, ${f.asset_criticality ?? '-'} importance) |`,\n    `| Package | ${f.pkg} - installed ${f.installed}, fixed in ${f.fixed || 'no fixed version available'} |`,\n    `| Severity | ${f.severity} (CVSS ${f.cvss}) |`,\n    `| EPSS exploitation probability | ${epss} |`,\n    `| CISA KEV listed | ${f.kev ? 'YES - actively exploited in the wild' : 'No'} |`,\n    `| Contextual priority | ${f.priority_score} / 100 - ${f.priority} |`,\n    `| SLA deadline | ${due.toISOString().slice(0, 10)} (${days} days) |`,\n    '', '> ' + (f.title || ''), '',\n    '### Priority formula',\n    'P = 0.25*CVSS + 0.30*EPSS + 0.25*KEV + 0.20*Asset importance', '',\n    '### Acceptance criteria',\n    '- [ ] Apply the fix (upgrade package or rebuild image)',\n    '- [ ] Request verification scan (dashboard -> Verify)',\n    '- [ ] Ticket is closed ONLY if a new scan proves the finding is gone', '',\n    '_Created by the n8n pipeline (scan -> EPSS/KEV/asset -> priority -> ticket)._',\n  ].join('\\n');\n  out.push({ json: { ...ref, action: 'create', payload: {\n    title: `[${f.priority}] Fix ${f.cve} on ${f.asset_name}`,\n    body,\n    labels: [labelIds[f.priority], f.kev ? labelIds['kev'] : null].filter(Boolean),\n    due_date: due.toISOString(),\n  } } });\n}\n\nconst count = a => out.filter(o => o.json.action === a).length;\nconsole.log('triage', JSON.stringify({ candidates: candidates.length, create: count('create'), reopen: count('reopen'), skip: count('skip') }));\nreturn out;\n"
      },
      "id": "b1000000-0024-4000-8000-pipeline025",
      "name": "Triage: create / reopen / skip",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3940,
