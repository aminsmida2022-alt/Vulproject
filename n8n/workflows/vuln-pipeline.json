      "id": "b1000000-0013-4000-8000-pipeline014",
      "name": "Fetch Accepted Risks",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2500,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// P = 0.25*C + 0.30*E + 0.25*K + 0.20*A\nconst { findings, epssMap } = $('Merge EPSS').first().json;\nconst kevSet = new Set($('Fetch CISA KEV').first().json.cves);\nconst assets = new Map($('Fetch Asset Inventory').first().json.assets.map(a => [a.asset_id, a]));\nconst exceptions = new Map($('Fetch Accepted Risks').first().json.exceptions.map(e => [e.cve, e]));\n\nconst label = s => s >= 80 ? 'P1-CRITICAL' : s >= 60 ? 'P2-HIGH' : s >= 40 ? 'P3-MEDIUM' : s >= 20 ? 'P4-LOW' : 'P5-INFORMATIONAL';\n\nconst enriched = [];\nfor (const f of findings) {\n  const exc = exceptions.get(f.cve);\n  if (exc) continue; // accepted risk, dated and approved -> excluded\n\n  const c = Math.min((f.cvss ?? 0) / 10 * 100, 100);\n  const e = (epssMap[f.cve] ?? 0) * 100;\n  const k = kevSet.has(f.cve) ? 100 : 0;\n  const a = f.importance ?? 50;\n  const score = Math.round((0.25 * c + 0.30 * e + 0.25 * k + 0.20 * a) * 100) / 100;\n\n  enriched.push({\n    ...f,\n    epss: epssMap[f.cve] ?? 0,\n    kev: kevSet.has(f.cve),\n    priority_score: score,\n    priority: label(score),\n  });\n}\n\nenriched.sort((x, y) => y.priority_score - x.priority_score);\nreturn [{ json: { findings: enriched } }];"
      },
      "id": "b1000000-0014-4000-8000-pipeline015",
      "name": "Compute Priority",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2740,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:8000/api/agent/findings",
        "sendHeaders": true,
        "headerParameters": {
