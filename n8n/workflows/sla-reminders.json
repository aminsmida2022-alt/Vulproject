      "id": "c2000000-0003-4000-8000-slaworkflow3",
      "name": "Get Open Tickets",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -200,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// SLA policy (same as the ticket due dates): P1-CRITICAL 7 days, P2-HIGH 30 days.\n//   >= 75% of the SLA elapsed  -> reminder   (label sla-warning)\n//   deadline passed            -> escalation (labels sla-breached + escalated)\n// Each stage fires once per ticket (the label is the memory). risk-accepted tickets are ignored.\nconst SLA_DAYS = { 'P1-CRITICAL': 7, 'P2-HIGH': 30 };\nconst DAY = 86400000;\nconst now = Date.now();\nconst actions = [];\n\nfor (const issue of $input.all().map(i => i.json)) {\n  const m = (issue.title || '').match(/^\\[(P\\d-[A-Z]+)\\]/);\n  if (!m || !SLA_DAYS[m[1]]) continue;\n  const prio = m[1];\n  const labels = (issue.labels || []).map(l => l.name);\n  if (labels.includes('risk-accepted')) continue;\n\n  const created = Date.parse(issue.created_at);\n  const due = issue.due_date ? Date.parse(issue.due_date) : created + SLA_DAYS[prio] * DAY;\n  const dueStr = new Date(due).toISOString().slice(0, 10);\n  const ratio = (now - created) / Math.max(due - created, 1);\n\n  if (now > due && !labels.includes('sla-breached')) {\n    const late = Math.ceil((now - due) / DAY);\n    actions.push({ json: { number: issue.number, action: 'escalate', labels: ['sla-breached', 'escalated'],\n      body: `### SLA breached - escalated\\nDeadline was **${dueStr}** (${prio}, ${SLA_DAYS[prio]} days). ` +\n            `Overdue by ${late} day(s).\\nEscalated to the security manager (@vulnadmin). ` +\n            `Fix the finding or file a risk-acceptance exception.` } });\n  } else if (now <= due && ratio >= 0.75 && !labels.includes('sla-warning')) {\n    const left = Math.max(0, Math.ceil((due - now) / DAY));\n    actions.push({ json: { number: issue.number, action: 'remind', labels: ['sla-warning'],\n      body: `### SLA reminder\\n${Math.round(ratio * 100)}% of the SLA elapsed - ${left} day(s) left before **${dueStr}**.` } });\n  }\n}\nconsole.log('sla', JSON.stringify({ checked: $input.all().length, actions: actions.length }));\nreturn actions;   // empty = nothing to do, the run ends here\n"
      },
      "id": "c2000000-0004-4000-8000-slaworkflow4",
      "name": "Classify SLA",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
