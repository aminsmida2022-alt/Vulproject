flowchart TD
    S["Analyst clicks Verify in the dashboard<br/>(or Run manually in n8n)"] --> W["n8n Remediation Verification<br/>POST /webhook/verify-request {ticket}"]
    W --> P["read the Gitea ticket<br/>parse CVE + asset from the title"]
    P --> T["proof scan with Trivy<br/>(agent API, raw mode) + poll"]
    T --> Q{"CVE still in the<br/>fresh reports?"}
    Q -- no --> OK["evidence comment<br/>label verified-fixed<br/>CLOSE ticket"]
    Q -- yes --> KO["evidence comment<br/>label verification-failed<br/>ticket stays open"]
    T --> E[("dashboard evidence<br/>tickets/evidence/*.json<br/>verification_log.jsonl")]
